
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "sangbeos1410@gmail.com";
    }

    match /menu/{id} {
      allow read: if isAdmin()
        || (resource != null && resource.data.active == true);

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'description',
          'sizes', 'toppings', 'active', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.sizes is list
        && request.resource.data.sizes.size() >= 1
        && request.resource.data.sizes.size() <= 5
        && request.resource.data.toppings is list
        && request.resource.data.toppings.size() <= 20
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status', 'paymentStatus', 'updatedAt'
          ])
        && request.resource.data.status
          in ['new', 'preparing', 'done']
        && request.resource.data.paymentStatus
          in ['pending', 'paid']
        && request.resource.data.updatedAt == request.time;
    }

    match /dailyStats/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminDevices/{id} {
      allow read, delete: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'token', 'uid', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.updatedAt == request.time;
    }

    match /storeSettings/contact {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'openingHours', 'address',
          'facebook', 'zalo', 'tagline', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.openingHours is string
        && request.resource.data.openingHours.size() <= 100
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200
        && request.resource.data.facebook is string
        && request.resource.data.facebook.size() <= 300
        && request.resource.data.zalo is string
        && request.resource.data.zalo.size() <= 300
        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 180
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /storeSettings/payment {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'bankName', 'accountName', 'accountNumber',
          'qrImageUrl', 'qrStoragePath',
          'instructions', 'updatedAt'
        ])
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() <= 100
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() <= 120
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() <= 50
        && request.resource.data.qrImageUrl is string
        && request.resource.data.qrImageUrl.size() <= 1000
        && request.resource.data.qrStoragePath is string
        && request.resource.data.qrStoragePath.size() <= 300
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() <= 300
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /menuCosts/{id} {
      allow read, delete: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'sizes', 'toppings', 'updatedAt'
        ])
        && request.resource.data.sizes is map
        && request.resource.data.sizes.size() >= 1
        && request.resource.data.sizes.size() <= 5
        && request.resource.data.toppings is map
        && request.resource.data.toppings.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    match /toppingCatalog/{id} {
      allow read, delete: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'price', 'cost', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000000
        && request.resource.data.cost is int
        && request.resource.data.cost >= 0
        && request.resource.data.cost <= 100000000
        && request.resource.data.updatedAt == request.time;
    }

    match /promotions/{id} {
      allow read: if resource.data.active == true || isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'percent', 'minTotal',
          'startsAt', 'endsAt', 'active', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.percent is int
        && request.resource.data.percent >= 1
        && request.resource.data.percent <= 100
        && request.resource.data.minTotal is int
        && request.resource.data.minTotal >= 0
        && request.resource.data.minTotal <= 100000000
        && request.resource.data.startsAt is int
        && request.resource.data.startsAt >= 0
        && request.resource.data.endsAt is int
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.endsAt <= 8640000000000000
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /requestIds/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
