rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "sangbeos1410@gmail.com";
    }

    match /menu/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','price','active','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 10000000
        && request.resource.data.active is bool;
    }

    // Khách KHÔNG được ghi trực tiếp orders/dailyStats.
    // Chỉ Cloud Function (Admin SDK) tạo đơn và tính tiền.
    match /orders/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['new','preparing','done'];
    }

    match /dailyStats/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminDevices/{id} {
      allow read: if false;
      allow create, update, delete: if isAdmin()
        && request.resource.data.uid == request.auth.uid;
    }

    match /requestIds/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
