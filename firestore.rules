rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // =====================================
    // HÀM CHUNG
    // =====================================

    function signedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "sangbeos1410@gmail.com";
    }


    // =====================================
    // MENU
    // =====================================

    match /menu/{id} {

      // Khách chỉ đọc món đang bán.
      // Admin đọc toàn bộ.
      allow read:
        if resource.data.active == true
        || isAdmin();


      // Chỉ Admin được tạo hoặc sửa menu.
      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'name',
          'category',
          'description',
          'sizes',
          'toppings',
          'active',
          'updatedAt'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100

        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80

        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300

        && request.resource.data.sizes is list
        && request.resource.data.sizes.size() >= 1
        && request.resource.data.sizes.size() <= 5

        && request.resource.data.toppings is list
        && request.resource.data.toppings.size() <= 20

        && request.resource.data.active is bool

        && request.resource.data.updatedAt == request.time;


      // Chỉ Admin được xóa món.
      allow delete:
        if isAdmin();

    }


    // =====================================
    // ORDERS
    // =====================================

    match /orders/{id} {

      // Chỉ Admin đọc được đơn.
      allow read:
        if isAdmin();


      // Client không được tự tạo đơn.
      // Cloud Function dùng Admin SDK để tạo.
      allow create:
        if false;


      // Admin chỉ được thay đổi trạng thái đơn.
      allow update:
        if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.status
          in [
            'new',
            'preparing',
            'done'
          ]

        && request.resource.data.updatedAt
          == request.time;


      // Không cho client xóa đơn.
      allow delete:
        if false;

    }


    // =====================================
    // DAILY STATS
    // =====================================

    match /dailyStats/{id} {

      // Chỉ Admin xem thống kê.
      allow read:
        if isAdmin();


      // Chỉ Cloud Function ghi.
      allow write:
        if false;

    }


    // =====================================
    // ADMIN DEVICES
    // =====================================

    match /adminDevices/{id} {

      // Admin có thể đọc để quản lý thiết bị.
      allow read:
        if isAdmin();


      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'token',
          'uid',
          'updatedAt'
        ])

        && request.resource.data.uid
          == request.auth.uid

        && request.resource.data.token
          is string

        && request.resource.data.token.size()
          > 20

        && request.resource.data.updatedAt
          == request.time;


      allow delete:
        if isAdmin();

    }


    // =====================================
    // STORE SETTINGS / CONTACT
    // =====================================

    match /storeSettings/{id} {

      // Khách được đọc thông tin liên hệ
      // để hiển thị ở cuối trang.
      allow read:
        if id == "contact";


      // Chỉ Admin được tạo / sửa.
      allow create, update:
        if isAdmin()

        && id == "contact"

        && request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'openingHours',
          'address',
          'facebook',
          'zalo',
          'tagline',
          'updatedAt'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100

        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30

        && request.resource.data.openingHours is string
        && request.resource.data.openingHours.size() <= 100

        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200

        && request.resource.data.facebook is string
        && request.resource.data.facebook.size() <= 300

        && request.resource.data.zalo is string
        && request.resource.data.zalo.size() <= 300

        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 180

        && request.resource.data.updatedAt
          == request.time;


      // Nếu sau này muốn xóa thông tin quán.
      allow delete:
        if isAdmin();

    }


    // =====================================
    // REQUEST IDS
    // =====================================

    match /requestIds/{id} {

      // Chỉ Cloud Function dùng
      // để chống gửi trùng đơn.
      allow read, write:
        if false;

    }


    // =====================================
    // MẶC ĐỊNH KHÓA TẤT CẢ
    // =====================================

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}