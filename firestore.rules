rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // =====================================
    // HÀM CHUNG
    // =====================================

    function signedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "sangbeos1410@gmail.com";
    }


    // =====================================
    // MENU
    // =====================================

    match /menu/{id} {

      // Khách chỉ xem món đang bán.
      // Admin xem toàn bộ.
      allow read:
        if resource.data.active == true
        || isAdmin();


      // Chỉ Admin được tạo/sửa menu.
      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'name',
          'category',
          'description',
          'sizes',
          'toppings',
          'active',
          'updatedAt'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100

        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80

        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300

        && request.resource.data.sizes is list
        && request.resource.data.sizes.size() >= 1
        && request.resource.data.sizes.size() <= 5

        && request.resource.data.toppings is list
        && request.resource.data.toppings.size() <= 20

        && request.resource.data.active is bool

        && request.resource.data.updatedAt == request.time;


      allow delete:
        if isAdmin();

    }


    // =====================================
    // ORDERS
    // =====================================

    match /orders/{id} {

      // Chỉ Admin đọc đơn.
      allow read:
        if isAdmin();


      // Client không tự ghi order.
      // Cloud Function dùng Admin SDK tạo order.
      allow create:
        if false;


      /*
        Admin được đổi:
        - trạng thái đơn
        - trạng thái thanh toán

        Không được sửa:
        - giá
        - món
        - thông tin khách
        - địa chỉ
        - tổng tiền
      */
      allow update:
        if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'paymentStatus',
            'updatedAt'
          ])

        && request.resource.data.status
          in [
            'new',
            'preparing',
            'done'
          ]

        && request.resource.data.paymentStatus
          in [
            'pending',
            'paid'
          ]

        && request.resource.data.updatedAt
          == request.time;


      // Không cho client xóa đơn.
      allow delete:
        if false;

    }


    // =====================================
    // DAILY STATS
    // =====================================

    match /dailyStats/{id} {

      // Chỉ Admin xem thống kê.
      allow read:
        if isAdmin();


      // Chỉ Cloud Function ghi.
      allow write:
        if false;

    }


    // =====================================
    // ADMIN DEVICES / FCM
    // =====================================

    match /adminDevices/{id} {

      allow read:
        if isAdmin();


      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'token',
          'uid',
          'updatedAt'
        ])

        && request.resource.data.uid
          == request.auth.uid

        && request.resource.data.token
          is string

        && request.resource.data.token.size()
          > 20

        && request.resource.data.updatedAt
          == request.time;


      allow delete:
        if isAdmin();

    }


    // =====================================
    // STORE SETTINGS - CONTACT
    // =====================================

    match /storeSettings/contact {

      // Public read để trang khách hiển thị footer.
      allow read:
        if true;


      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'openingHours',
          'address',
          'facebook',
          'zalo',
          'tagline',
          'updatedAt'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100

        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30

        && request.resource.data.openingHours is string
        && request.resource.data.openingHours.size() <= 100

        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200

        && request.resource.data.facebook is string
        && request.resource.data.facebook.size() <= 300

        && request.resource.data.zalo is string
        && request.resource.data.zalo.size() <= 300

        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 180

        && request.resource.data.updatedAt
          == request.time;


      allow delete:
        if isAdmin();

    }


    // =====================================
    // STORE SETTINGS - PAYMENT
    // =====================================

    match /storeSettings/payment {

      /*
        Public read vì khách cần xem:
        - ngân hàng
        - số tài khoản
        - QR
        - hướng dẫn

        Không nên lưu bất kỳ secret nào ở đây.
      */
      allow read:
        if true;


      // Chỉ Admin được sửa thanh toán.
      allow create, update:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          'bankName',
          'accountName',
          'accountNumber',
          'qrImageUrl',
          'instructions',
          'updatedAt'
        ])

        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() <= 100

        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() <= 120

        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() <= 50

        && request.resource.data.qrImageUrl is string
        && request.resource.data.qrImageUrl.size() <= 500

        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() <= 300

        && request.resource.data.updatedAt
          == request.time;


      allow delete:
        if isAdmin();

    }


    // =====================================
    // REQUEST IDS
    // =====================================

    match /requestIds/{id} {

      // Chỉ Cloud Function dùng chống gửi trùng.
      allow read, write:
        if false;

    }


    // =====================================
    // KHÓA MẶC ĐỊNH
    // =====================================

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}